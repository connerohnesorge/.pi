{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"test": {
			"dependsOn": ["build"],
			"outputs": []
		},
		"pack:dry": {
			"dependsOn": ["build"],
			"outputs": []
		},
		"check": {
			"dependsOn": ["^check"],
			"outputs": []
		},
		"clean": {
			"cache": false
		}
	}
}
