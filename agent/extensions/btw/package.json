{
	"name": "btw",
	"version": "0.4.1",
	"description": "A pi extension for parallel side conversations with /btw",
	"type": "module",
	"license": "MIT",
	"author": "Conner Ohnesorge",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/connerohnesorge/.pi.git",
		"directory": "agent/extensions/btw"
	},
	"homepage": "https://github.com/connerohnesorge/.pi/tree/main/agent/extensions/btw#readme",
	"bugs": {
		"url": "https://github.com/connerohnesorge/.pi/issues"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi-coding-agent",
		"agent",
		"tui"
	],
	"files": [
		"extensions",
		"docs",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "vitest --run",
		"build": "node -e \"console.log('source-first pi extension; no build step')\"",
		"typecheck": "tsc --noEmit",
		"pack:dry": "npm pack --dry-run",
		"check": "npm run build && npm run typecheck && npm run test && npm run pack:dry"
	},
	"pi": {
		"extensions": [
			"./extensions/btw.ts"
		],
		"skills": [
			"./skills"
		],
		"image": "https://raw.githubusercontent.com/connerohnesorge/.pi/main/agent/extensions/btw/docs/btw-overlay.png"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "^0.74.0 || ^0.75.0",
		"@earendil-works/pi-coding-agent": "^0.74.0 || ^0.75.0",
		"@earendil-works/pi-tui": "^0.74.0 || ^0.75.0"
	},
	"devDependencies": {
		"typescript": "^6.0.2",
		"vitest": "^4.1.0"
	}
}
