{
	"name": "otel",
	"version": "0.1.0",
	"description": "OpenTelemetry traces and metrics extension for pi coding agent",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"pi-coding-agent",
		"extension",
		"opentelemetry",
		"otel",
		"telemetry",
		"tracing",
		"metrics"
	],
	"author": "Conner Ohnesorge",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/connerohnesorge/.pi.git",
		"directory": "agent/extensions/otel"
	},
	"homepage": "https://github.com/connerohnesorge/.pi/tree/main/agent/extensions/otel#readme",
	"bugs": {
		"url": "https://github.com/connerohnesorge/.pi/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"files": [
		"index.ts",
		"README.md"
	],
	"scripts": {
		"test": "vitest --run",
		"typecheck": "tsc --noEmit",
		"pack:dry": "npm pack --dry-run",
		"check": "npm run typecheck && npm run test && npm run pack:dry"
	},
	"dependencies": {
		"@grpc/grpc-js": "^1.14.4",
		"@opentelemetry/api": "^1.9.0",
		"@opentelemetry/exporter-metrics-otlp-grpc": "^0.57.2",
		"@opentelemetry/exporter-metrics-otlp-http": "^0.57.2",
		"@opentelemetry/exporter-trace-otlp-grpc": "^0.57.2",
		"@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
		"@opentelemetry/resources": "^1.30.1",
		"@opentelemetry/sdk-metrics": "^1.30.1",
		"@opentelemetry/sdk-trace-base": "^1.30.1",
		"@opentelemetry/sdk-trace-node": "^1.30.1",
		"@opentelemetry/semantic-conventions": "^1.28.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.74.0"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "latest",
		"@types/node": "latest",
		"typescript": "latest",
		"vitest": "latest"
	}
}
