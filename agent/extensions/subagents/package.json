{
	"name": "pi-subagents",
	"version": "0.26.0",
	"description": "Pi extension for dynamic workflow orchestration with isolated subagents and a bordered TUI",
	"author": "Conner Ohnesorge",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./src/extension/index.ts"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/connerohnesorge/.pi.git",
		"directory": "agent/extensions/subagents"
	},
	"homepage": "https://github.com/connerohnesorge/.pi/tree/main/agent/extensions/subagents#readme",
	"bugs": {
		"url": "https://github.com/connerohnesorge/.pi/issues"
	},
	"keywords": [
		"pi-package",
		"pi",
		"pi-coding-agent",
		"workflow",
		"workflows",
		"dynamic-workflows",
		"subagents",
		"orchestration",
		"multi-agent"
	],
	"bin": {
		"pi-subagents": "install.mjs"
	},
	"files": [
		"src/**/*.ts",
		"*.mjs",
		"README.md",
		"CHANGELOG.md",
		"THIRD_PARTY_NOTICES.md"
	],
	"scripts": {
		"test": "node --experimental-transform-types --test tests/*.test.ts",
		"pack:dry": "npm pack --dry-run",
		"check": "npm run test && npm run pack:dry"
	},
	"pi": {
		"extensions": [
			"./src/extension/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		}
	},
	"dependencies": {
		"acorn": "^8.16.0",
		"@earendil-works/pi-tui": "^0.74.0",
		"typebox": "^1.1.24"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^0.74.0",
		"@earendil-works/pi-coding-agent": "^0.74.0"
	}
}
