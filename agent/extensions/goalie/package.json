{
	"name": "goalie",
	"version": "1.0.0",
	"description": "Goalie: session-scoped Stop hook condition contract manager with a magnificent live progress auditor widget and $EDITOR editing.",
	"license": "MIT",
	"author": "Conner Ohnesorge",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"goal",
		"sisyphus",
		"autoresearch",
		"agent-loop",
		"long-running"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/connerohnesorge/.pi.git",
		"directory": "agent/extensions/goalie"
	},
	"homepage": "https://github.com/connerohnesorge/.pi/tree/main/agent/extensions/goalie#readme",
	"bugs": {
		"url": "https://github.com/connerohnesorge/.pi/issues"
	},
	"files": [
		"extensions",
		"README.md",
		"docs",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"extensions/goal.ts"
		],
		"image": "https://raw.githubusercontent.com/connerohnesorge/.pi/main/agent/extensions/goalie/screenshot.png"
	},
	"scripts": {
		"check": "npm run typecheck && npm run test && npm run pack:dry",
